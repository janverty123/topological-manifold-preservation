.venv/
data/*
!data/.gitkeep

# Per-experiment generated artifacts -- keep folder structure, ignore contents
outputs/experiments/*/models/*
!outputs/experiments/*/models/.gitkeep
outputs/experiments/*/logs/*
!outputs/experiments/*/logs/.gitkeep
outputs/experiments/*/diagrams/*
!outputs/experiments/*/diagrams/.gitkeep
outputs/experiments/*/plots/*
!outputs/experiments/*/plots/.gitkeep

outputs/archive/*
!outputs/archive/.gitkeep

configs/archive/*
!configs/archive/.gitkeep

__pycache__/
*.pyc
.ipynb_checkpoints/
